#ifdef USE_AWS
// AWS
// AWS IoT Core エンドポイント
#define AWS_IOT_ENDPOINT "***-ats.iot.ap-northeast-1.amazonaws.com"

#define AWS_IOT_PUBLISH_TOPIC   "clients/***/devices/***"
#define AWS_IOT_SUBSCRIBE_TOPIC "clients/***/devices/***"

// AWS ルートCA証明書
static const char AWS_CERT_CA[] = R"EOF(
-----BEGIN CERTIFICATE-----
-----END CERTIFICATE-----
)EOF";

// デバイス証明書 (Certificate)
static const char AWS_CERT_CRT[] = R"EOF(
-----BEGIN CERTIFICATE-----
-----END CERTIFICATE-----
)EOF";

// デバイス秘密鍵 (Private Key)
static const char AWS_CERT_PRIVATE[] = R"KEY(
-----BEGIN RSA PRIVATE KEY-----
-----END RSA PRIVATE KEY-----
)KEY";
